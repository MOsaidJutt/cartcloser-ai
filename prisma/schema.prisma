// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── MODELS ───────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  openaiKey     String?
  // Phase 2 GHL fields
  ghlApiToken   String?
  ghlLocationId String?
  // Stripe billing
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  planStatus           String    @default("free") // "free" | "trialing" | "active" | "past_due" | "canceled"
  planName             String    @default("free") // "free" | "starter" | "pro" | "agency"
  currentPeriodEnd     DateTime?
  agents        Agent[]
  createdAt     DateTime @default(now())
}

model Agent {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  storeName       String
  storeUrl        String
  storeLogo       String?
  currency        String    @default("$")
  botName         String
  openingMessage  String
  couponCode      String?
  couponDiscount  String?
  tone            String    @default("casual")
  systemPrompt    String
  knowledgeBase   String
  productCount    Int       @default(0)
  demoViews       Int       @default(0)   // incremented every time someone opens the demo
  conversions     Int       @default(0)   // incremented every time a visitor clicks a checkout/product link
  status          String    @default("building")
  // Per-agent customisation config (JSON string)
  config           String    @default("{}")
  // Knowledge base auto-refresh schedule
  refreshInterval  Int?
  refreshUnit      String?   // "day" | "week" | "month"
  nextRefreshAt    DateTime?
  lastRefreshedAt  DateTime?
  // Phase 2 GHL fields
  ghlAgentId       String?
  ghlWorkflowId    String?
  ghlDeployed      Boolean   @default(false)
  ghlDeployedAt    DateTime?
  ghlWebhookSecret String?
  // Shopify order tracking
  shopifyWebhookSecret String?
  totalRevenue         Float     @default(0)
  conversations   Conversation[]
  coupons         Coupon[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Coupon {
  id            String   @id @default(cuid())
  agentId       String
  agent         Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  code          String
  discountType  String   @default("percentage") // "percentage" | "fixed"
  discountValue String   // e.g. "10" (for 10% or $10)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model Conversation {
  id             String    @id @default(cuid())
  agentId        String
  agent          Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  visitorName    String
  productName    String?   // product shown in opening message
  ghlContactId   String?   // GHL contact ID for live SMS conversations
  // Shopify order conversion tracking
  shopifyOrderId    String?
  shopifyOrderTotal String?   // e.g. "129.99"
  convertedAt       DateTime?
  messages       Message[]
  createdAt      DateTime  @default(now())
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String       // "user" | "assistant"
  content        String
  createdAt      DateTime     @default(now())
}
